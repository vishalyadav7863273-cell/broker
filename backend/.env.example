NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (replace placeholders)
MONGODB_URI=mongodb+srv://vishalyadav7863273_db_user:broker123@cluster0.nvk7f1d.mongodb.net/flat_rental?retryWrites=true&w=majority&appName=Cluster0

# Frontend origins allowed by CORS (comma separated)
CLIENT_URLS=http://localhost:5173

# JWT secrets - use long random strings (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Initial admin (used only by: npm run create-admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeThisStrongPassword!1

# Razorpay online payments. Use TEST keys first (Razorpay dashboard > Settings > API Keys).
# Webhook: Dashboard > Settings > Webhooks > URL https://<your-api>/api/payments/webhook,
# events payment.captured, order.paid, payment.failed; paste the same secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email alerts to the admin's Gmail (new booking / registration / payment).
# Gmail: turn on 2-Step Verification, then create an "App password" at https://myaccount.google.com/apppasswords
# and paste the 16 characters below (NOT your normal Gmail password).
SMTP_USER=vishalyadav7863273@gmail.com
# Paste the 16-character App password here, in your own .env only. Never commit it or put it in code.
SMTP_PASS=
# Where alerts are sent (comma separated). Falls back to ADMIN_EMAIL above.
ADMIN_NOTIFY_EMAIL=vishalyadav7863273@gmail.com
# Optional: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  MAIL_FROM="HomeKey <yourgmail@gmail.com>"
# Dev tip: MAIL_DRY_RUN=true prints emails in the console instead of sending them.
MAIL_DRY_RUN=false
